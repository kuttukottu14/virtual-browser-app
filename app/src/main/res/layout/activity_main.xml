<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header Title & Global Search Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Multi-Browser Bot (5 Layouts)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <Button
            android:id="@+id/btnSearchAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEARCH ALL"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Layout Tabs Navigation (Horizontal Scroll for 5 Tabs) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTab1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layout 1"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnTab2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layout 2"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnTab3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layout 3"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnTab4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layout 4"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnTab5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layout 5"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- CONTAINER 1: Layout 1 -->
    <LinearLayout
        android:id="@+id/layoutContainer1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <EditText
            android:id="@+id/urlEditText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Layout 1 URL"
            android:inputType="textUri"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/uaEditText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:hint="User-Agent 1"
            android:textSize="11sp"
            android:maxLines="2"/>

        <WebView
            android:id="@+id/webView1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- CONTAINER 2: Layout 2 -->
    <LinearLayout
        android:id="@+id/layoutContainer2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/urlEditText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Layout 2 URL"
            android:inputType="textUri"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/uaEditText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:hint="User-Agent 2"
            android:textSize="11sp"
            android:maxLines="2"/>

        <WebView
            android:id="@+id/webView2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- CONTAINER 3: Layout 3 -->
    <LinearLayout
        android:id="@+id/layoutContainer3"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/urlEditText3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Layout 3 URL"
            android:inputType="textUri"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/uaEditText3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:hint="User-Agent 3"
            android:textSize="11sp"
            android:maxLines="2"/>

        <WebView
            android:id="@+id/webView3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- CONTAINER 4: Layout 4 -->
    <LinearLayout
        android:id="@+id/layoutContainer4"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/urlEditText4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Layout 4 URL"
            android:inputType="textUri"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/uaEditText4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:hint="User-Agent 4"
            android:textSize="11sp"
            android:maxLines="2"/>

        <WebView
            android:id="@+id/webView4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

    <!-- CONTAINER 5: Layout 5 -->
    <LinearLayout
        android:id="@+id/layoutContainer5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/urlEditText5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Layout 5 URL"
            android:inputType="textUri"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/uaEditText5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:hint="User-Agent 5"
            android:textSize="11sp"
            android:maxLines="2"/>

        <WebView
            android:id="@+id/webView5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

</LinearLayout>
            
